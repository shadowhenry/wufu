.notice {
  display: flex;
  align-items: center;
  margin: 16rpx 28rpx 0;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.notice-text {
  flex: 1;
}

.notice-close {
  margin-left: 20rpx;
  font-size: 34rpx;
  line-height: 1;
  opacity: 0.55;
  padding: 0 6rpx;
}

.notice-error {
  background: rgba(178, 58, 46, 0.08);
  color: #9c3227;
}

.notice-warn {
  background: rgba(178, 138, 59, 0.12);
  color: #8a6a3b;
}

.notice-info {
  background: rgba(92, 124, 138, 0.12);
  color: #5c7c8a;
}