.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.hidden-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.title {
  padding: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2620;
}

.tabs {
  width: 100%;
  background: #fffdf8;
  white-space: nowrap;
}

.tabs-row {
  display: inline-flex;
  padding: 0 20rpx;
}

.tab {
  padding: 22rpx 26rpx;
  font-size: 26rpx;
  color: #7a7266;
}

.tab-active {
  color: #8a6a3b;
  font-weight: 600;
  border-bottom: 4rpx solid #8a6a3b;
}

.ops {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 28rpx;
}

.op {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(138, 106, 59, 0.1);
  color: #8a6a3b;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  padding: 4rpx 28rpx;
}

.cell {
  background: #fffdf8;
  border-radius: 14rpx;
  overflow: hidden;
}

.thumb {
  width: 100%;
  height: 190rpx;
  display: block;
  background: #efe7d8;
}

.name {
  padding: 10rpx 12rpx 12rpx;
  font-size: 21rpx;
  color: #4a4034;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9a9186;
  font-size: 26rpx;
}