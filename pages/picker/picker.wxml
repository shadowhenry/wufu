<!-- 压缩兜底用的隐藏画布：仅降分辨率时启用 -->
<canvas type="2d" id="compress-canvas" class="hidden-canvas" />

<view class="page">
  <inline-notice id="notice" bind:ready="onNoticeReady" />
  <view class="title">选择素材 · {{slotName}}</view>
  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tabs-row">
      <view
        class="tab {{active === item.key ? 'tab-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="ops">
    <view class="op" bindtap="pickFromAlbum">从相册上传</view>
    <view class="op" bindtap="goAi">AI 生成</view>
  </view>

  <view wx:if="{{!items.length}}" class="empty">这个分类还没有素材</view>

  <view wx:else class="grid">
    <view class="cell" wx:for="{{items}}" wx:key="id" data-index="{{index}}" bindtap="choose">
      <image class="thumb" src="{{item.displayPath}}" mode="aspectFill" />
      <view class="name">{{item.name}}</view>
    </view>
  </view>
</view>