.page {
  padding-bottom: 160rpx;
}

.tabs {
  width: 100%;
  background: #fffdf8;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(138, 106, 59, 0.1);
}

.tabs-row {
  display: inline-flex;
  padding: 0 20rpx;
}

.tab {
  padding: 24rpx 26rpx;
  font-size: 27rpx;
  color: #7a7266;
}

.tab-active {
  color: #8a6a3b;
  font-weight: 600;
  border-bottom: 4rpx solid #8a6a3b;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 12rpx;
}

.bar-text {
  font-size: 24rpx;
  color: #9a9186;
}

.upload-tip {
  padding: 0 28rpx 12rpx;
  font-size: 20rpx;
  color: #a9a094;
  line-height: 1.5;
}

.bar-action {
  font-size: 24rpx;
  color: #8a6a3b;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(138, 106, 59, 0.1);
}

/* 没有文字行之后改成三列，一屏能看到更多素材 */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
  padding: 12rpx 28rpx;
}

.cell {
  position: relative;
  background: #fffdf8;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(139, 106, 59, 0.07);
}

.thumb {
  width: 100%;
  height: 220rpx;
  display: block;
  background: #efe7d8;
}

/* 删除做成角标圆点，避免在纯图墙上出现文字块 */
.cell-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(40, 34, 28, 0.55);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.empty {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #9a9186;
  font-size: 26rpx;
}

.empty-main {
  margin-bottom: 32rpx;
}

.empty-ops {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.empty-ops .btn-ghost {
  padding: 18rpx 40rpx;
}

.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  background: #8a6a3b;
  color: #fffdf8;
  font-size: 26rpx;
  padding: 22rpx 34rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(138, 106, 59, 0.28);
}