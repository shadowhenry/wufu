.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.tabs {
  width: 100%;
  background: #fffdf8;
  white-space: nowrap;
  border-bottom: 1rpx solid rgba(138, 106, 59, 0.1);
}

.tabs-row {
  display: inline-flex;
  padding: 0 20rpx;
}

.tab {
  padding: 24rpx 26rpx;
  font-size: 27rpx;
  color: #7a7266;
}

.tab-active {
  color: #8a6a3b;
  font-weight: 600;
  border-bottom: 4rpx solid #8a6a3b;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 12rpx;
}

.bar-text {
  font-size: 24rpx;
  color: #9a9186;
}

.bar-action {
  font-size: 24rpx;
  color: #8a6a3b;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(138, 106, 59, 0.1);
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 12rpx 28rpx;
}

.cell {
  position: relative;
  background: #fffdf8;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(139, 106, 59, 0.07);
}

.thumb {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #efe7d8;
}

.cell-name {
  padding: 14rpx 16rpx 6rpx;
  font-size: 25rpx;
  color: #2b2620;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cell-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
}

.cell-cat {
  font-size: 20rpx;
  color: #9a9186;
}

.cell-badge {
  font-size: 19rpx;
  color: #8a6a3b;
  background: rgba(138, 106, 59, 0.1);
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
}

.cell-badge.ai {
  color: #5c7c8a;
  background: rgba(92, 124, 138, 0.12);
}

.cell-del {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(40, 34, 28, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.empty {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #9a9186;
  font-size: 26rpx;
}

.empty-main {
  margin-bottom: 32rpx;
}

.empty-ops {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.empty-ops .btn-ghost {
  padding: 18rpx 40rpx;
}

.float-btn {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  background: #8a6a3b;
  color: #fffdf8;
  font-size: 26rpx;
  padding: 22rpx 34rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(138, 106, 59, 0.28);
}