<view class="page">
  <inline-notice id="notice" bind:ready="onNoticeReady" />
  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tabs-row">
      <view
        class="tab {{active === item.key ? 'tab-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="bar">
    <view class="bar-text">{{total}} 个素材</view>
    <view class="bar-action" bindtap="goUpload">上传图片</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">
    <view class="empty-main">这个分类还没有素材</view>
    <view class="empty-ops">
      <view class="btn-ghost" bindtap="goUpload">上传图片</view>
      <view class="btn-ghost" bindtap="goAi">AI 生成</view>
    </view>
  </view>

  <view wx:else class="grid">
    <view class="cell" wx:for="{{items}}" wx:key="id">
      <image class="thumb" src="{{item.displayPath}}" mode="aspectFill" data-id="{{item.id}}" bindtap="preview" />
      <view class="cell-name">{{item.name}}</view>
      <view class="cell-foot">
        <text class="cell-cat">{{item.categoryLabel}}</text>
        <text wx:if="{{item.source === 'builtin'}}" class="cell-badge">内置</text>
        <text wx:else class="cell-badge ai">AI</text>
      </view>
      <view wx:if="{{item.source !== 'builtin'}}" class="cell-del" data-id="{{item.id}}" catchtap="remove">删除</view>
    </view>
  </view>

  <view class="float-btn" bindtap="goAi">AI 生成素材</view>
</view>