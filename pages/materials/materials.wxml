<view class="page">
  <inline-notice id="notice" bind:ready="onNoticeReady" />
  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tabs-row">
      <view
        class="tab {{active === item.key ? 'tab-active' : ''}}"
        wx:for="{{categories}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchCategory"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="bar">
    <view class="bar-text">{{total}} 个素材</view>
    <view class="bar-action" bindtap="goUpload">上传图片</view>
  </view>
  <view class="upload-tip">点图直接进创作页（以它为底图），长按可看大图；上传时会自动压到 1M 以内</view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{!items.length}}" class="empty">
    <view class="empty-main">这个分类还没有素材</view>
    <view class="empty-ops">
      <view class="btn-ghost" bindtap="goUpload">上传图片</view>
      <view class="btn-ghost" bindtap="goAi">AI 生成</view>
    </view>
  </view>

  <!-- 纯图墙：缩略图下方不放任何文字，点图即进创作页，长按看大图 -->
  <view wx:else class="grid">
    <view class="cell" wx:for="{{items}}" wx:key="id">
      <image
        class="thumb"
        src="{{item.displayPath}}"
        mode="aspectFill"
        data-id="{{item.id}}"
        bindtap="useMaterial"
        bindlongpress="preview"
      />
      <view wx:if="{{item.source !== 'builtin'}}" class="cell-del" data-id="{{item.id}}" catchtap="remove">×</view>
    </view>
  </view>

  <view class="float-btn" bindtap="goAi">AI 生成素材</view>
</view>