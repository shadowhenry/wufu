<view class="page">
  <inline-notice id="notice" bind:ready="onNoticeReady" />
  <view class="mode-row">
    <view
      class="mode {{mode === 'image' ? 'mode-active' : ''}}"
      data-mode="image"
      bindtap="switchMode"
    >生成素材</view>
    <view
      class="mode {{mode === 'copy' ? 'mode-active' : ''}}"
      data-mode="copy"
      bindtap="switchMode"
    >生成文案</view>
  </view>

  <!-- 素材生成 -->
  <view wx:if="{{mode === 'image'}}">
    <view class="seg">
      <view class="seg-item {{genMode === 'text2img' ? 'seg-active' : ''}}" data-gen="text2img" bindtap="switchGenMode">文生图</view>
      <view class="seg-item {{genMode === 'img2img' ? 'seg-active' : ''}}" data-gen="img2img" bindtap="switchGenMode">图生图</view>
    </view>

    <view wx:if="{{genMode === 'img2img'}}" class="ref-box">
      <image wx:if="{{reference.path}}" class="ref-thumb" src="{{reference.path}}" mode="aspectFill" />
      <view wx:else class="ref-picker" bindtap="pickReference">
        <text class="ref-plus">+</text>
        <text class="ref-hint">上传参考图</text>
      </view>
      <view wx:if="{{reference.path}}" class="ref-clear" bindtap="clearReference">更换</view>
    </view>

    <view class="field-label">画面描述</view>
    <textarea
      class="input"
      value="{{input}}"
      bindinput="onInput"
      placeholder="例如：宣纸质感的远山，一叶扁舟，大面积留白，低饱和度"
      auto-height
      maxlength="500"
    />

    <view class="presets">
      <view class="preset" wx:for="{{presets}}" wx:key="value" data-value="{{item.value}}" bindtap="usePreset">{{item.label}}</view>
    </view>

    <view class="advanced" wx:if="{{showAdvanced}}">
      <view class="field-label">补充风格（可选）</view>
      <input class="input-line" value="{{styleHint}}" bindinput="onStyleInput" placeholder="例如：工笔淡彩，低饱和，克制的留白" />
    </view>

    <view class="toggle" bindtap="toggleAdvanced">{{showAdvanced ? '收起风格设置' : '添加风格要求'}}</view>

    <view wx:if="{{streamText}}" class="preview-box">
      <view class="preview-title">AI 优化后的提示词</view>
      <view class="preview-text">{{streamText}}</view>
    </view>

    <view class="actions">
      <view class="btn-ghost" bindtap="rewritePrompt">只优化提示词</view>
      <view class="btn-primary {{generating ? 'disabled' : ''}}" bindtap="generate">{{generating ? '生成中…' : '生成素材图'}}</view>
    </view>

    <view wx:if="{{results.length}}" class="results">
      <view class="result-item" wx:for="{{results}}" wx:key="path">
        <image
          class="result-img"
          src="{{item.path}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewResult"
        />
        <view class="result-ops">
          <view class="result-op {{item.saved ? 'done' : ''}}" data-index="{{index}}" bindtap="saveToLibrary">
            {{item.saved ? '已在素材库' : '保存为素材'}}
          </view>
          <button
            class="result-op share"
            open-type="share"
            data-index="{{index}}"
            data-path="{{item.path}}"
          >分享</button>
        </view>
      </view>
    </view>
  </view>

  <!-- 文案生成 -->
  <view wx:if="{{mode === 'copy'}}">
    <view class="field-label">主题</view>
    <input class="input-line" value="{{theme}}" bindinput="onThemeInput" placeholder="例如：第一等事" />

    <view class="field-label">补充要求（可选）</view>
    <textarea
      class="input"
      value="{{brief}}"
      bindinput="onBriefInput"
      placeholder="例如：偏课程宣传风格，突出修身立德"
      auto-height
      maxlength="300"
    />

    <view class="actions">
      <view class="btn-primary {{generating ? 'disabled' : ''}}" bindtap="generateCopy">{{generating ? '生成中…' : '生成文案'}}</view>
    </view>

    <view wx:if="{{copyResult}}" class="copy-box">
      <view class="field-label">主标题</view>
      <view class="input-line readonly" data-field="title" bindtap="copyField">{{copyResult.title}}</view>
      <view class="field-label">副标题</view>
      <view class="input-line readonly" data-field="subtitle" bindtap="copyField">{{copyResult.subtitle}}</view>
      <view class="field-label" wx:for="{{copyResult.points}}" wx:key="title">{{index + 1}}. {{item.title}}</view>
      <view class="point-body" wx:for="{{copyResult.points}}" wx:key="body">{{item.body}}</view>
      <view class="field-label" wx:if="{{copyResult.source}}">出处</view>
      <view class="input-line readonly" wx:if="{{copyResult.source}}">{{copyResult.source}}</view>
      <view class="actions">
        <view class="btn-ghost" bindtap="copyToEditor">应用到海报</view>
      </view>
    </view>
  </view>
</view>