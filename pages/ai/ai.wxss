.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
}

.mode-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.mode {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #6b6357;
  padding: 20rpx 0;
  background: #fffdf8;
  border-radius: 16rpx;
}

.mode-active {
  background: #8a6a3b;
  color: #fffdf8;
  font-weight: 600;
}

.seg {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  padding: 16rpx 0;
  background: rgba(138, 106, 59, 0.08);
  color: #7a6e5c;
  border-radius: 14rpx;
}

.seg-active {
  background: #8a6a3b;
  color: #fffdf8;
}

.ref-box {
  position: relative;
  margin-bottom: 22rpx;
}

.ref-thumb {
  width: 100%;
  height: 360rpx;
  border-radius: 18rpx;
  background: #efe7d8;
}

.ref-picker {
  height: 220rpx;
  border-radius: 18rpx;
  border: 2rpx dashed rgba(138, 106, 59, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ref-plus {
  font-size: 60rpx;
  color: #8a6a3b;
  line-height: 1;
}

.ref-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9a9186;
}

.ref-clear {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background: rgba(40, 34, 28, 0.62);
  color: #fff;
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.field-label {
  font-size: 23rpx;
  color: #8d8477;
  margin: 18rpx 0 10rpx;
}

.input {
  width: 100%;
  min-height: 140rpx;
  background: #fffdf8;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #2b2620;
  box-sizing: border-box;
}

.input-line {
  width: 100%;
  background: #fffdf8;
  border-radius: 14rpx;
  padding: 22rpx 20rpx;
  font-size: 26rpx;
  color: #2b2620;
  box-sizing: border-box;
}

.input-line.readonly {
  color: #4a4034;
}

.presets {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin: 18rpx 0;
}

.preset {
  font-size: 22rpx;
  color: #8a6a3b;
  background: rgba(138, 106, 59, 0.1);
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
}

.toggle {
  font-size: 24rpx;
  color: #8a6a3b;
  padding: 14rpx 0;
}

.preview-box {
  background: #fffdf8;
  border-radius: 18rpx;
  padding: 22rpx;
  margin: 18rpx 0;
}

.preview-title {
  font-size: 23rpx;
  color: #8d8477;
  margin-bottom: 12rpx;
}

.preview-text {
  font-size: 24rpx;
  color: #4a4034;
  line-height: 1.7;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin: 26rpx 0;
}

.actions .btn-ghost,
.actions .btn-primary {
  flex: 1;
}

.actions .btn-primary.disabled {
  background: #cfc6b8;
  color: #fdfbf7;
}

.results {
  margin-top: 10rpx;
}

.result-item {
  margin-bottom: 22rpx;
  background: #fffdf8;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(139, 106, 59, 0.08);
}

.result-img {
  width: 100%;
  height: 480rpx;
  display: block;
  background: #efe7d8;
}

.result-ops {
  display: flex;
  gap: 14rpx;
  padding: 18rpx;
}

.result-op {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: #8a6a3b;
  background: rgba(138, 106, 59, 0.1);
  padding: 18rpx;
  border-radius: 999rpx;
}

.result-op.done {
  color: #4a7c59;
  background: rgba(74, 124, 89, 0.12);
}

.result-op.share {
  color: #fffdf8;
  background: #8a6a3b;
  border: none;
  line-height: inherit;
}

.result-op.share::after {
  border: none;
}

.copy-box {
  background: #fffdf8;
  border-radius: 18rpx;
  padding: 22rpx;
}

.point-body {
  font-size: 25rpx;
  color: #4a4034;
  line-height: 1.7;
  margin-bottom: 10rpx;
}