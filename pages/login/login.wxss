.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #efe9dd;
  padding: 40rpx;
  box-sizing: border-box;
}

.login-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  font-size: 72rpx;
  margin-bottom: 36rpx;
}

.login-title {
  font-size: 34rpx;
  color: #2b2620;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.login-desc {
  font-size: 24rpx;
  color: #9a9186;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 48rpx;
  padding: 0 40rpx;
}

.login-btn {
  display: inline-block;
  padding: 24rpx 48rpx;
  background: #8a6a3b;
  color: #fffdf8;
  font-size: 28rpx;
  border-radius: 999rpx;
  text-align: center;
}

.login-btn:active {
  opacity: 0.9;
}

.login-reason {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #9a9186;
}