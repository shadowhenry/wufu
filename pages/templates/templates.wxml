<view class="page">
  <inline-notice id="notice" bind:ready="onNoticeReady" />

  <!-- 只开放一类物料时不渲染筛选条：单独一个「海报」摆在那儿没意义。
       之后再开门类，typeOptions 变多，筛选条会自动回来。 -->
  <view wx:if="{{showTypeBar}}" class="type-bar">
    <view
      class="type-chip {{item.active ? 'is-active' : ''}}"
      wx:for="{{types}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchType"
    >{{item.name}}</view>
  </view>

  <view class="bar">
    <view class="bar-text">{{templates.length}} 个{{typeName}}模板</view>
    <view class="bar-action" bindtap="goCreate">自己拼一张</view>
  </view>
  <view class="upload-tip">点图直接进创作页（以它为底图），长按可看大图</view>

  <view wx:if="{{!templates.length}}" class="empty">
    <view class="empty-main">这一类还没有模板</view>
    <view class="empty-ops">
      <view class="btn-ghost" bindtap="goCreate">自己拼一张</view>
    </view>
  </view>

  <!-- 纯图墙：与素材库完全一致。模板本质就是一张做好的图，
       缩略图下方不放任何文字说明，点图即进创作页，长按看大图。 -->
  <view wx:else class="grid">
    <view class="cell" wx:for="{{templates}}" wx:key="key">
      <image
        class="thumb"
        src="{{item.cover}}"
        mode="aspectFill"
        data-key="{{item.key}}"
        bindtap="useTemplate"
        bindlongpress="preview"
      />
      <view wx:if="{{item.source !== 'builtin'}}" class="cell-del" data-id="{{item.id}}" catchtap="remove">×</view>
    </view>
  </view>

  <view class="tip">
    模板就是一张做好的图：点它进创作页，在提示词里写清要换成什么文字与元素，AI 重新生成一张新图。
    自己生成的成品图也能存成模板。
  </view>
</view>
