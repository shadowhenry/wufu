/* 与素材库同一套布局模型：页面只留底部留白，横向边距由各块自己带 */
.page {
  padding-bottom: 60rpx;
}

/* 物料类型筛选：与首页共用一份选择。
   只剩一类时整条不渲染（见 showTypeBar），之后再开门类会自动出现。 */
.type-bar {
  display: flex;
  gap: 14rpx;
  padding: 24rpx 28rpx 4rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.type-chip {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  border: 2rpx solid rgba(138, 106, 59, 0.16);
  font-size: 24rpx;
  color: #6b6357;
}

.type-chip.is-active {
  background: #8a6a3b;
  border-color: #8a6a3b;
  color: #fffdf8;
  font-weight: 600;
}

.bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
}

.bar-text {
  font-size: 24rpx;
  color: #9a9186;
}

.bar-action {
  font-size: 24rpx;
  color: #8a6a3b;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(138, 106, 59, 0.1);
}

.upload-tip {
  padding: 0 28rpx 12rpx;
  font-size: 20rpx;
  color: #a9a094;
  line-height: 1.5;
}

/* 三列图墙，与素材库同一套尺寸 */
.grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
  padding: 12rpx 28rpx;
}

.cell {
  position: relative;
  background: #fffdf8;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(139, 106, 59, 0.07);
}

.thumb {
  width: 100%;
  height: 220rpx;
  display: block;
  background: #efe7d8;
}

/* 删除做成角标圆点，避免在纯图墙上出现文字块 */
.cell-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(40, 34, 28, 0.55);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.empty {
  padding: 140rpx 40rpx;
  text-align: center;
  color: #9a9186;
  font-size: 26rpx;
}

.empty-main {
  margin-bottom: 32rpx;
}

.empty-ops {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.empty-ops .btn-ghost {
  padding: 18rpx 40rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #a9a094;
  line-height: 1.7;
  padding: 0 28rpx;
}
