.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

.hero {
  padding: 56rpx 40rpx 40rpx;
  background: linear-gradient(160deg, #f2e7d2 0%, #e8dcc4 100%);
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  color: #2b2620;
  letter-spacing: 6rpx;
  font-family: STKaiti, Kaiti SC, serif;
}

.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #7a6e5c;
  letter-spacing: 1rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 28rpx;
}

.quick-card {
  background: #fffdf8;
  border-radius: 22rpx;
  padding: 28rpx 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(139, 106, 59, 0.07);
}

.quick-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #8a6a3b;
  color: #fffdf8;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: STKaiti, Kaiti SC, serif;
}

.quick-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2b2620;
}

.quick-desc {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9a9186;
  line-height: 1.4;
}

.tpl-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 28rpx;
}

.tpl-card {
  padding: 26rpx 24rpx;
  border-radius: 20rpx;
  background: #fffdf8;
  border: 1rpx solid rgba(138, 106, 59, 0.14);
}

.tpl-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b2620;
}

.tpl-desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9a9186;
  line-height: 1.6;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b2620;
  margin: 36rpx 28rpx 20rpx;
}

.recent-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 0 28rpx;
}

.recent-item {
  background: #fffdf8;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(139, 106, 59, 0.07);
}

.thumb {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #efe7d8;
}

.recent-poster {
  position: relative;
  width: 100%;
}

.recent-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  color: #a9a094;
  background: #efe7d8;
}

.recent-title {
  padding: 16rpx 18rpx 4rpx;
  font-size: 26rpx;
  color: #2b2620;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-time {
  padding: 0 18rpx 18rpx;
  font-size: 20rpx;
  color: #a9a094;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #9a9186;
  font-size: 26rpx;
}