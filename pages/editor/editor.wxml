<view class="page">
  <inline-notice id="notice" bind:ready="onNoticeReady" />
  <view class="stage-wrap">
    <view class="stage-holder" style="width: {{stageWidth}}px; height: {{stageHeight}}px;">
      <canvas
        type="2d"
        id="posterCanvas"
        class="poster-canvas"
        style="width: {{stageWidth}}px; height: {{stageHeight}}px;"
      ></canvas>
    </view>
    <view wx:if="{{selectedLabel}}" class="selected-hint">已选中：{{selectedLabel}}</view>
  </view>

  <view class="toolbar">
    <view class="tool {{tab === 'text' ? 'tool-active' : ''}}" data-tab="text" bindtap="switchTab">文字</view>
    <view class="tool {{tab === 'image' ? 'tool-active' : ''}}" data-tab="image" bindtap="switchTab">图片</view>
    <view class="tool {{tab === 'sticker' ? 'tool-active' : ''}}" data-tab="sticker" bindtap="switchTab">贴纸</view>
    <view class="tool {{tab === 'bg' ? 'tool-active' : ''}}" data-tab="bg" bindtap="switchTab">底色</view>
  </view>

  <!-- 文字 -->
  <view wx:if="{{tab === 'text'}}" class="panel">
    <view wx:if="{{!textFields.length}}" class="panel-empty">还没有文字，点下面添加</view>
    <view wx:else class="field" wx:for="{{textFields}}" wx:key="slot">
      <view class="field-head">
        <view class="field-label">{{item.name}}</view>
        <view class="field-ops">
          <text class="field-op {{item.selected ? 'field-op-on' : ''}}" data-slot="{{item.slot}}" bindtap="selectText">样式</text>
          <text class="field-op danger" data-slot="{{item.slot}}" catchtap="removeText">删除</text>
        </view>
      </view>
      <textarea
        class="field-input"
        value="{{item.text}}"
        data-slot="{{item.slot}}"
        bindinput="onTextInput"
        placeholder="输入文字"
        auto-height
        maxlength="120"
      />
    </view>

    <!-- 选中文字后的样式面板 -->
    <view wx:if="{{selectedText}}" class="style-box">
      <view class="style-title">文字样式 · {{selectedText.name}}</view>

      <view class="style-row">
        <text class="style-label">字号</text>
        <slider
          class="style-slider"
          min="16"
          max="140"
          value="{{selectedText.size}}"
          activeColor="#8a6a3b"
          data-slot="{{selectedText.slot}}"
          bindchange="onSizeChange"
          block-size="18"
        />
        <text class="style-value">{{selectedText.size}}</text>
      </view>

      <view class="style-row">
        <text class="style-label">颜色</text>
        <view class="color-list">
          <view
            class="color-dot {{selectedText.color === item ? 'color-on' : ''}}"
            wx:for="{{textColors}}"
            wx:key="*this"
            style="background: {{item}}"
            data-color="{{item}}"
            bindtap="onColorChange"
          ></view>
        </view>
      </view>

      <view class="style-row">
        <text class="style-label">粗细</text>
        <view class="chip-list">
          <view
            class="chip {{selectedText.weight === item.value ? 'chip-on' : ''}}"
            wx:for="{{weightPresets}}"
            wx:key="key"
            data-weight="{{item.value}}"
            bindtap="onWeightChange"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="style-row">
        <text class="style-label">字体</text>
        <view class="chip-list">
          <view
            class="chip {{selectedText.fontKey === item.key ? 'chip-on' : ''}}"
            wx:for="{{fontPresets}}"
            wx:key="key"
            data-font="{{item.value}}"
            bindtap="onFontChange"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="style-row">
        <text class="style-label">对齐</text>
        <view class="chip-list">
          <view
            class="chip {{selectedText.align === item.key ? 'chip-on' : ''}}"
            wx:for="{{alignPresets}}"
            wx:key="key"
            data-align="{{item.key}}"
            bindtap="onAlignChange"
          >{{item.label}}</view>
        </view>
      </view>

      <view class="style-row">
        <text class="style-label">字距</text>
        <slider
          class="style-slider"
          min="0"
          max="16"
          value="{{selectedText.letterSpacing}}"
          activeColor="#8a6a3b"
          data-slot="{{selectedText.slot}}"
          bindchange="onLetterSpacingChange"
          block-size="18"
        />
        <text class="style-value">{{selectedText.letterSpacing}}</text>
      </view>
    </view>

    <view class="panel-actions">
      <view class="btn-ghost" bindtap="addText">+ 添加文字</view>
      <view wx:if="{{textFields.length}}" class="btn-ghost" bindtap="aiCopy">AI 生成文案</view>
    </view>
  </view>

  <!-- 图片 -->
  <view wx:if="{{tab === 'image'}}" class="panel">
    <view wx:if="{{!imageSlots.length}}" class="panel-empty">还没有图片，点下面添加</view>
    <view wx:else class="slot-card" wx:for="{{imageSlots}}" wx:key="slot">
      <image class="slot-thumb" src="{{item.displayPath}}" mode="aspectFill" />
      <view class="slot-info" data-slot="{{item.slot}}" bindtap="selectImage">
        <view class="slot-name">{{item.name}}</view>
        <view class="slot-value">{{item.materialName || '未设置'}} · 点此设样式</view>
      </view>
      <view class="slot-ops">
        <view class="slot-pick" data-slot="{{item.slot}}" catchtap="pickMaterial">换图</view>
        <view class="slot-del" data-slot="{{item.slot}}" catchtap="removeImage">删除</view>
      </view>
    </view>

    <view wx:if="{{selectedImage}}" class="style-box">
      <view class="style-title">图片设置 · {{selectedImage.name}}</view>
      <view class="style-row">
        <text class="style-label">填充</text>
        <view class="chip-list">
          <view
            class="chip {{selectedImage.fit === 'cover' ? 'chip-on' : ''}}"
            data-fit="cover"
            bindtap="onFitChange"
          >裁剪填满</view>
          <view
            class="chip {{selectedImage.fit === 'contain' ? 'chip-on' : ''}}"
            data-fit="contain"
            bindtap="onFitChange"
          >完整显示</view>
        </view>
      </view>
      <view class="style-row">
        <text class="style-label">透明度</text>
        <slider
          class="style-slider"
          min="10"
          max="100"
          value="{{selectedImage.opacityPercent}}"
          activeColor="#8a6a3b"
          data-slot="{{selectedImage.slot}}"
          bindchange="onLayerOpacityChange"
          block-size="18"
        />
        <text class="style-value">{{selectedImage.opacityPercent}}%</text>
      </view>
      <view class="style-row">
        <text class="style-label">圆角</text>
        <slider
          class="style-slider"
          min="0"
          max="120"
          value="{{selectedImage.radius}}"
          activeColor="#8a6a3b"
          data-slot="{{selectedImage.slot}}"
          bindchange="onRadiusChange"
          block-size="18"
        />
        <text class="style-value">{{selectedImage.radius}}</text>
      </view>
    </view>

    <view class="panel-actions">
      <view class="btn-ghost" bindtap="addImage">+ 添加图片</view>
      <view class="btn-ghost" bindtap="goAi">AI 生成一张</view>
    </view>
  </view>

  <!-- 贴纸 -->
  <view wx:if="{{tab === 'sticker'}}" class="panel">
    <view class="field-label">添加贴纸</view>
    <view class="sticker-grid">
      <view
        class="sticker-item"
        wx:for="{{stickerPresets}}"
        wx:key="key"
        data-kind="{{item.key}}"
        bindtap="addSticker"
      >{{item.name}}</view>
    </view>

    <view wx:if="{{!stickerLayers.length}}" class="panel-empty">还没有贴纸</view>
    <view wx:else class="sticker-list" wx:for="{{stickerLayers}}" wx:key="slot">
      <view class="sticker-row {{item.selected ? 'sticker-row-on' : ''}}" data-slot="{{item.slot}}" bindtap="selectSticker">
        <view class="sticker-swatch" style="background: {{item.fill}}"></view>
        <view class="sticker-name">{{item.label}}</view>
        <text class="sticker-del" data-slot="{{item.slot}}" catchtap="removeSticker">删除</text>
      </view>
    </view>

    <view wx:if="{{selectedSticker}}" class="style-box">
      <view class="style-title">贴纸设置</view>
      <view class="style-row">
        <text class="style-label">颜色</text>
        <view class="color-list">
          <view
            class="color-dot {{selectedSticker.fill === item ? 'color-on' : ''}}"
            wx:for="{{stickerColors}}"
            wx:key="*this"
            style="background: {{item}}"
            data-color="{{item}}"
            bindtap="onStickerColor"
          ></view>
        </view>
      </view>
      <view class="style-row">
        <text class="style-label">大小</text>
        <slider
          class="style-slider"
          min="40"
          max="400"
          value="{{selectedSticker.w}}"
          activeColor="#8a6a3b"
          data-slot="{{selectedSticker.slot}}"
          bindchange="onStickerSize"
          block-size="18"
        />
        <text class="style-value">{{selectedSticker.w}}</text>
      </view>
      <view class="style-row">
        <text class="style-label">旋转</text>
        <slider
          class="style-slider"
          min="-180"
          max="180"
          value="{{selectedSticker.rotation}}"
          activeColor="#8a6a3b"
          data-slot="{{selectedSticker.slot}}"
          bindchange="onStickerRotation"
          block-size="18"
        />
        <text class="style-value">{{selectedSticker.rotation}}°</text>
      </view>
    </view>
  </view>

  <!-- 底色 -->
  <view wx:if="{{tab === 'bg'}}" class="panel">
    <view class="field-label">底色</view>
    <view class="swatches">
      <view
        class="swatch"
        wx:for="{{swatches}}"
        wx:key="value"
        style="background: {{item.bg}}"
        data-value="{{item.value}}"
        bindtap="pickBackground"
      ></view>
    </view>
    <view class="field-label">底图不透明度</view>
    <slider
      class="opacity-slider"
      min="10"
      max="100"
      value="{{imageOpacity}}"
      activeColor="#8a6a3b"
      bindchange="onOpacityChange"
      block-size="20"
    />
    <view class="opacity-value">{{imageOpacity}}%</view>
  </view>

  <view class="footer">
    <view class="foot-btn ghost" bindtap="previewImage">预览</view>
    <view class="foot-btn ghost" bindtap="saveAsTemplate">存为模板</view>
    <view class="foot-btn primary {{busy ? 'disabled' : ''}}" bindtap="savePoster">{{busy ? '生成中…' : '生成海报'}}</view>
  </view>
</view>